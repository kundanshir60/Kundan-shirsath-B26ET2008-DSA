#include <stdio.h>
#define MAX 5

char queue[MAX];
int front=-1, rear=-1;

void send()
{
    char data;
    if(rear==MAX-1)
        printf("Buffer is full\n");
    else
    {
        printf("Enter character to send: ");
        scanf(" %c",&data);
        if(front==-1)
            front=0;
        queue[++rear]=data;
        printf("Data sent: %c\n",data);
    }
}

void receive()
{
    if(front==-1)
        printf("No data received\n");
    else
    {
        printf("Data received: %c\n",queue[front]);
        if(front==rear)
            front=rear=-1;
        else
            front++;
    }
}

void display()
{
    int i;
    if(front==-1)
        printf("Buffer is empty\n");
    else
    {
        printf("Buffer data: ");
        for(i=front;i<=rear;i++)
            printf("%c ",queue[i]);
        printf("\n");
    }
}

int main()
{
    int ch;
    do
    {
        printf("\n1.Send Data\n2.Receive Data\n3.Display Buffer\n4.Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1: send(); break;
            case 2: receive(); break;
            case 3: display(); break;
            case 4: break;
            default: printf("Invalid choice\n");
        }
    }while(ch!=4);

    return 0;
}
