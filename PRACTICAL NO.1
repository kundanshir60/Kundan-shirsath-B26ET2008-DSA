#include <stdio.h>
#include <string.h>

int main()
{
    char s1[100], s2[100], s3[100], rev[100];
    int i, len, start, n, flag = 1;
    printf("Enter first string: ");
    scanf("%99s", s1);
    printf("Enter second string: ");
    scanf("%99s", s2);
    len = strlen(s1);

    printf("\nSubstring operation\n");
    printf("Enter starting position and length: ");
    scanf("%d %d", &start, &n);

    if (start >= 0 && start <= len && n >= 0 && n <= len - start)
    {
        strncpy(s3, s1 + start, n);
        s3[n] = '\0';
        printf("Substring = %s\n", s3);
    }
    else
        printf("Invalid substring\n");
    printf("\nPalindrome operation\n");
    for (i = 0; i < len / 2; i++)
   {
     if (s1[i] != s1[len - 1 - i])
  {
        flag = 0;
        break;
  }
    }
    if (flag)
        printf("String is palindrome\n");
    else
        printf("String is not palindrome\n");

    printf("\nCompare operation\n");
    if (strcmp(s1, s2) == 0)
        printf("Strings are equal\n");
    else
        printf("Strings are not equal\n");

    printf("\nCopy operation\n");
    strcpy(s3, s1);
    printf("Copied string = %s\n", s3);

    printf("\nReverse operation\n");
    for (i = 0; i < len; i++)
        rev[i] = s1[len - 1 - i];

   rev[len] = '\0';
printf("Reversed string = %s\n", rev);
  return 0;
}
