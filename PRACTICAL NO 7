#include <stdio.h>
#include <ctype.h>
#include <stdlib.h>

int stack[100], top=-1;

int main()
{
    char exp[100], ch;
    int i, a, b;

    printf("Enter postfix expression: ");
    scanf("%99s", exp);

    for(i=0; exp[i]!='\0'; i++)
    {
        ch=exp[i];

        if(isdigit(ch))
            stack[++top]=ch-'0';
        else
        {
            b=stack[top--];
            a=stack[top--];

            switch(ch)
            {
  case '+': stack[++top]=a+b; break;
  case '-': stack[++top]=a-b; break;
  case '*': stack[++top]=a*b; break;
                case '/':
                    if(b==0)
                    {
                        printf("Division by zero error\n");
                        return 1;
                    }
            stack[++top]=a/b;
                    break;
            }
        }
    }

    printf("Result = %d\n", stack[top]);
    return 0;
}
