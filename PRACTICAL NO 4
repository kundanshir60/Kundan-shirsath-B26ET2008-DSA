#include <stdio.h>
struct student
{
    int roll;
    char name[50];
    float marks;
};

int main()
{
    struct student s[100], temp;
    int n=0, ch, i, j, r, found;

    do
    {
        printf("\n1.Create\n2.Display\n3.Modify\n4.Search\n5.Sort\n6.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &ch);

        switch(ch)
        {
            case 1:
                printf("Enter number of students: ");
                scanf("%d", &n);
                if(n<1 || n>100)
                {
                    printf("Invalid number\n");
                    n=0;
                    break;
                }
                for(i=0; i<n; i++)
                {
                    printf("Enter roll, name and marks: ");
                    scanf("%d %49s %f", &s[i].roll, s[i].name, &s[i].marks);
                }
                break;

            case 2:
                printf("\nRoll\tName\tMarks\n");
                for(i=0; i<n; i++)
                    printf("%d\t%s\t%.2f\n", s[i].roll, s[i].name, s[i].marks);
                break;

            case 3:
                printf("Enter roll number: ");
                scanf("%d", &r);
                found=0;
                for(i=0; i<n; i++)
                    if(s[i].roll==r)
                    {
                        printf("Enter new name and marks: ");
                        scanf("%49s %f", s[i].name, &s[i].marks);
                        found=1;
                        printf("Record modified\n");
                        break;
                    }
                if(!found)
                    printf("Record not found\n");
                break;

            case 4:
                printf("Enter roll number: ");
                scanf("%d", &r);
                found=0;
                for(i=0; i<n; i++)
                    if(s[i].roll==r)
                    {
                        printf("Roll: %d\nName: %s\nMarks: %.2f\n", s[i].roll, s[i].name, s[i].marks);
                        found=1;
                        break;
                    }
                if(!found)
                    printf("Record not found\n");
                break;

            case 5:
                for(i=0; i<n-1; i++)
                    for(j=0; j<n-i-1; j++)
                        if(s[j].roll>s[j+1].roll)
                        {
                            temp=s[j];
                            s[j]=s[j+1];
                            s[j+1]=temp;
                        }
                printf("Records sorted\n");
                break;

            case 6:
                printf("Exit\n");
                break;

            default:
                printf("Invalid choice\n");
        }
    } while(ch!=6);

    return 0;
}
